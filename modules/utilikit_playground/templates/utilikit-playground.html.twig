          <input type="text"
                 id="utilikit-class-input"
                 class="utilikit-text-input form-text form-element form-element--type-text form-element--api-textfield required"
                 placeholder="e.g., uk-pd--24 uk-bg--f0f9ff uk-tc--1e40af uk-br--8 uk-bs--solid uk-bw--2 uk-bc--3b82f6"
                 autocomplete="off" />
          <div class="class-autocomplete" id="class-autocomplete" style="display: none;"></div>
        </div>

        <details class="playground-details" id="class-builder">
          <summary>Visual Builder</summary>
          <div class="builder-sections">
            <div class="builder-section">
              <h4>Spacing</h4>
              <div class="builder-options">
