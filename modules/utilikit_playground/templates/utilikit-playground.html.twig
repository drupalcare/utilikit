                <span class="builder-chip" data-class="uk-pd--12-24-12-24">pd 12 24 12 24</span>
                <span class="builder-chip" data-class="uk-mg--b-0">mg bottom 0</span>
                <span class="builder-chip" data-class="uk-pd--2rem">pd 2rem</span>
                <span class="builder-chip" data-class="uk-pd--1d5em">pd 1.5em</span>
