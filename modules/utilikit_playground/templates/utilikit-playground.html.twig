{#
 # UtiliKit Playground - Interactive utility class testing interface.
 #
 # Variables:
 # - elements: Render element array passed from controller
 #}

<div class="utilikit-playground-wrapper layout-container">

  {# LEFT PANEL #}
  <div class="utilikit-column utilikit-input-panel region region-sidebar-first">

    <div class="preset-examples block">
      <h3 class="block-title">Quick Start Examples</h3>
      <div class="preset-grid">
        <button type="button" class="preset-btn button js-form-submit form-submit" data-preset="card">
          <strong>Card Component</strong>
          <small>Modern card with shadow</small>
        </button>
        <button type="button" class="preset-btn button js-form-submit form-submit" data-preset="hero">
          <strong>Hero Section</strong>
          <small>Centered hero banner</small>
        </button>
        <button type="button" class="preset-btn button js-form-submit form-submit" data-preset="flex">
          <strong>Flex Layout</strong>
          <small>3-column responsive</small>
        </button>
        <button type="button" class="preset-btn button js-form-submit form-submit" data-preset="grid">
          <strong>Grid Layout</strong>
          <small>Responsive grid</small>
        </button>
        <button type="button" class="preset-btn button js-form-submit form-submit" data-preset="form">
          <strong>Form Styling</strong>
          <small>Styled form inputs</small>
        </button>
        <button type="button" class="preset-btn button js-form-submit form-submit" data-preset="pricing">
          <strong>Pricing Card</strong>
          <small>Product pricing display</small>
        </button>
      </div>
    </div>

    <form id="utilikit-preview-form" class="utilikit-preview-form" novalidate>

      {# Tab bar #}
      <div class="playground-tabs">
        <button type="button" class="playground-tab active" data-tab="classes">Classes</button>
        <button type="button" class="playground-tab" data-tab="html">HTML Editor</button>
        <button type="button" class="playground-tab playground-tab--help" id="tutorial-btn" data-action="tutorial" title="Show Tutorial">?</button>
      </div>

      {# Classes tab #}
      <div class="playground-tab-content active" id="tab-classes" data-tab-content="classes">
        <p class="utilikit-description description">
          Type utility classes separated by spaces. Start with <code>uk-</code> to see suggestions.
