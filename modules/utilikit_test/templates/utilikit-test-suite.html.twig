{#
 # UtiliKit Test Suite Interface.
 #
 # Variables:
 # - test_groups: Test cases organized by utility category
 # - statistics: Test statistics including totalTests count
 #}

<div id="utilikit-test-suite" class="utilikit-test-page">

  <div id="test-summary" class="utilikit-test-summary">
    <div class="utilikit-test-stat">
      <span class="utilikit-test-stat__label">{{ 'Total'|t }}</span>
      <span class="utilikit-test-stat__value" id="total-tests">{{ statistics.totalTests }}</span>
    </div>
    <div class="utilikit-test-stat">
      <span class="utilikit-test-stat__label">{{ 'Passed'|t }}</span>
      <span class="utilikit-test-stat__value" id="passed-count">0</span>
    </div>
    <div class="utilikit-test-stat">
      <span class="utilikit-test-stat__label">{{ 'Failed'|t }}</span>
      <span class="utilikit-test-stat__value" id="failed-count">0</span>
    </div>
    <div class="utilikit-test-stat">
      <span class="utilikit-test-stat__label">{{ 'Status'|t }}</span>
      <span class="utilikit-test-stat__value utilikit-test-stat__value--status" id="test-status">{{ 'Ready'|t }}</span>
    </div>
  </div>

  <div id="test-progress-bar" class="utilikit-test-progress" style="display: none;">
    <div id="test-progress-fill" class="utilikit-test-progress__fill"></div>
    <span id="test-progress-text" class="utilikit-test-progress__text">0%</span>
  </div>

  <div class="utilikit-test-toolbar">
    <div class="utilikit-test-toolbar__filters">
      <label for="status-filter">{{ 'Status'|t }}</label>
      <select id="status-filter" class="form-select form-element form-element--type-select">
        <option value="all">{{ 'All'|t }}</option>
        <option value="passed">{{ 'Passed'|t }}</option>
        <option value="failed">{{ 'Failed'|t }}</option>
        <option value="pending">{{ 'Pending'|t }}</option>
      </select>

      <label for="group-filter">{{ 'Group'|t }}</label>
      <select id="group-filter" class="form-select form-element form-element--type-select">
        <option value="all">{{ 'All Groups'|t }}</option>
        {% for group_name in test_groups|keys %}
          <option value="{{ group_name }}">{{ group_name }}</option>
        {% endfor %}
      </select>
    </div>

    <div class="utilikit-test-toolbar__actions">
      <button id="run-tests" type="button" class="button button--primary">{{ 'Test All Groups'|t }}</button>
      <button id="stop-tests" type="button" class="button button--danger" style="display: none;">{{ 'Stop'|t }}</button>
      <button id="toggle-all" type="button" class="button">{{ 'Expand All'|t }}</button>
      <button id="export-results" type="button" class="button">{{ 'Export'|t }}</button>
      <button id="reset-tests" type="button" class="button">{{ 'Reset'|t }}</button>
    </div>
  </div>

  <div class="utilikit-test-groups">
    {% for group_name, rule_tests in test_groups %}
      <div class="utilikit-test-group" data-group="{{ group_name }}">
        <h2 class="utilikit-test-group__title">
          {{ group_name }}
          <span class="utilikit-test-group__count">({{ rule_tests|length }})</span>
          <span class="utilikit-test-group__badge" data-group-badge="{{ group_name }}"></span>
        </h2>

        {% for rule_test in rule_tests %}
          {% set prefix = rule_test.prefix %}
          {% set rule = rule_test.rule %}
          {% set tests = rule_test.tests %}

          <div class="utilikit-test-rule" data-prefix="{{ prefix }}">
            <div class="utilikit-test-rule__header">
              <h3>
                <code>{{ prefix }}</code> — {{ rule.css }}
                <span class="utilikit-test-rule__count">({{ tests|length }})</span>
              </h3>
              <button type="button" class="toggle-tests button button--small">{{ 'Show'|t }}</button>
            </div>

            <div class="utilikit-test-rule__body" style="display: none;">
              <table class="utilikit-test-table">
                <thead>
                  <tr>
                    <th>{{ 'Class'|t }}</th>
                    <th>{{ 'Type'|t }}</th>
                    <th>{{ 'Expected'|t }}</th>
                    <th>{{ 'Actual'|t }}</th>
                    <th>{{ 'Status'|t }}</th>
                    <th>{{ 'Preview'|t }}</th>
                  </tr>
                </thead>
                <tbody>
                  {% for test in tests %}
                    {% set test_id = prefix ~ '-' ~ loop.index0 %}
                    <tr class="utilikit-test-case" data-test-id="{{ test_id }}" data-test="{{ test|json_encode|escape('html_attr') }}">
                      <td><code>{{ test.className }}</code></td>
                      <td>{{ test.testType }}</td>
                      <td>
                        {% if test.cssProperty %}
                          <code>{{ test.cssProperty }}: {{ test.expectedValue }}</code>
                        {% else %}
                          <code>{{ test.expectedValue }}</code>
                        {% endif %}
                      </td>
                      <td class="test-actual">-</td>
                      <td class="test-status">
                        <span class="utilikit-test-badge utilikit-test-badge--pending">{{ 'Pending'|t }}</span>
                      </td>
                      <td>
                        {% set preview_classes = test.className %}
                        {% if prefix == 'bw' %}
                          {% set preview_classes = preview_classes ~ ' uk-bs--solid' %}
                        {% endif %}
                        <div class="preview-element utilikit {{ preview_classes }}">{{ 'TEST'|t }}</div>
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endfor %}
  </div>

  <div class="utilikit-test-log">
    <h2>{{ 'Test Log'|t }}</h2>
    <div id="test-log" class="utilikit-test-log__output">
      <div id="test-log-content"></div>
    </div>
    <button id="clear-log" type="button" class="button button--small button--danger">{{ 'Clear Log'|t }}</button>
  </div>
</div>
