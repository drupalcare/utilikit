{#
/**
 * @file
 * UtiliKit Help Page Template
 * Your friendly guide to mastering UtiliKit! 🚀
 *
 * Tab content is split into partial templates under includes/ for
 * maintainability. Each partial is a self-contained tab panel.
 */
#}

<div class="utilikit-help-page">

  {# Hero Introduction #}
  <div class="help-hero">
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="hero-emoji">🎨</span>
        Welcome to UtiliKit Help!
        <span class="hero-emoji">✨</span>
      </h1>
      <p class="hero-subtitle">
        Think of UtiliKit as your <strong>Swiss Army knife for CSS</strong> – but instead of tiny scissors and tweezers,
        you get powerful utility classes that make styling as easy as ordering pizza! 🍕
      </p>
      <div class="hero-badges">
        <span class="badge badge-primary">Blazing Fast</span>
        <span class="badge badge-success">Mobile-First</span>
        <span class="badge badge-info">Developer-Friendly</span>
        <span class="badge badge-warning">Utility-First</span>
      </div>
    </div>
  </div>

  {# Main Content with Vertical Tabs #}
  <div class="help-content">
    <div class="vertical-tabs-wrapper" data-responsive-tabs="992">

      {# Tab Navigation #}
      <button class="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="help-tabs-nav">
        <span class="mobile-nav-toggle__text">Navigation Menu</span>
      </button>
      <nav class="vertical-tabs-nav" id="help-tabs-nav" role="tablist">
        <button class="tab-button active" data-tab="getting-started" role="tab" aria-selected="true">
          <span class="tab-icon">🚀</span>
          <span class="tab-text">Getting Started</span>
        </button>
        <button class="tab-button" data-tab="how-it-works" role="tab">
          <span class="tab-icon">🧠</span>
          <span class="tab-text">How It Works</span>
        </button>
        <button class="tab-button" data-tab="developer-mode" role="tab">
          <span class="tab-icon">🛠️</span>
          <span class="tab-text">Developer Mode</span>
        </button>
        <button class="tab-button" data-tab="real-examples" role="tab">
          <span class="tab-icon">💎</span>
          <span class="tab-text">Real Examples</span>
        </button>
        <button class="tab-button" data-tab="responsive" role="tab">
          <span class="tab-icon">📱</span>
          <span class="tab-text">Responsive Magic</span>
        </button>
        <button class="tab-button" data-tab="troubleshooting" role="tab">
          <span class="tab-icon">🩺</span>
          <span class="tab-text">Troubleshooting</span>
        </button>
        <button class="tab-button" data-tab="pro-tips" role="tab">
          <span class="tab-icon">💡</span>
          <span class="tab-text">Pro Tips</span>
        </button>
        <button class="tab-button" data-tab="units-reference" role="tab">
          <span class="tab-icon">📏</span>
          <span class="tab-text">Supported Units</span>
        </button>
        <button class="tab-button" data-tab="cheat-sheet" role="tab">
          <span class="tab-icon">⚡</span>
          <span class="tab-text">Cheat Sheet</span>
        </button>
        <button class="tab-button" data-tab="special-cases" role="tab">
          <span class="tab-icon">📋</span>
          <span class="tab-text">Limitations</span>
        </button>
      </nav>

      {# Tab Content Panels #}
      <div class="vertical-tabs-content">
        {% include '@utilikit_help/includes/tab-getting-started.html.twig' %}
        {% include '@utilikit_help/includes/tab-how-it-works.html.twig' %}
        {% include '@utilikit_help/includes/tab-developer-mode.html.twig' %}
        {% include '@utilikit_help/includes/tab-real-examples.html.twig' %}
        {% include '@utilikit_help/includes/tab-responsive.html.twig' %}
        {% include '@utilikit_help/includes/tab-troubleshooting.html.twig' %}
        {% include '@utilikit_help/includes/tab-pro-tips.html.twig' %}
        {% include '@utilikit_help/includes/tab-units-reference.html.twig' %}
        {% include '@utilikit_help/includes/tab-cheat-sheet.html.twig' %}
        {% include '@utilikit_help/includes/tab-special-cases.html.twig' %}
      </div>
    </div>
  </div>

  {# Footer #}
  <footer class="help-footer">
    <div class="footer-content">
      <p>Hand-tuned styles by <a target="_blank" rel="noopener noreferrer" href="https://www.alaahaddad.com">Alaa Haddad</a> — because CSS deserves kindness. 🌿</p>
      <p>UtiliKit – Utility classes without the utility bills. 💡</p>
    </div>
  </footer>

</div>
