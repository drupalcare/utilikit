            </div>
            <div class="utilikit uk-dp--flex uk-gp--12 uk-ai--center uk-pd--12 uk-bg--f9fafb uk-br--6">
              <div class="utilikit uk-wd--8 uk-ht--8 uk-bg--f59e0b uk-br--50pr"></div>
              <span class="utilikit uk-fg--1 uk-fs--14">System update completed</span>
              <span class="utilikit uk-fs--12 uk-tc--6b7280">Yesterday</span>
            </div>
          </div>
        </div>
        <!-- Side Panel -->
        <div class="utilikit uk-bg--ffffff uk-pd--24 uk-br--8 uk-bw--1 uk-bs--solid uk-bc--e5e7eb">
          <h2 class="utilikit uk-fs--20 uk-fw--600 uk-mg--b-16">Quick Actions</h2>
          <div class="utilikit uk-dp--flex uk-fd--column uk-gp--8">
            <button class="utilikit uk-pd--12 uk-bg--3b82f6 uk-tc--ffffff uk-br--6 uk-fw--500 uk-ta--center uk-bw--0">Add User</button>
            <button class="utilikit uk-pd--12 uk-bg--10b981 uk-tc--ffffff uk-br--6 uk-fw--500 uk-ta--center uk-bw--0">Generate Report</button>
            <button class="utilikit uk-pd--12 uk-bg--6b7280 uk-tc--ffffff uk-br--6 uk-fw--500 uk-ta--center uk-bw--0">View Logs</button>
