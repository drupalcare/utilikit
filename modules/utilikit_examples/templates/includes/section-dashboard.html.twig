      <div class="utilikit uk-dp--grid uk-gc--1fr uk-lh--1d6 uk-sm-gc--1fr-1fr uk-lg-gc--repeat-4-1fr uk-gp--16 uk-mg--b-32">
        <div class="utilikit uk-bg--ffffff uk-pd--20 uk-br--8 uk-bw--1 uk-bs--solid uk-bc--e5e7eb">
          <div class="utilikit uk-fs--14 uk-tc--6b7280 uk-fw--500 uk-mg--b-4">Total Users</div>
          <div class="utilikit uk-fs--32 uk-fw--700 uk-tc--1f2937">1,234</div>
          <div class="utilikit uk-fs--12 uk-tc--10b981">+12% from last month</div>
        </div>
        <div class="utilikit uk-bg--ffffff uk-pd--20 uk-br--8 uk-bw--1 uk-bs--solid uk-bc--e5e7eb">
          <div class="utilikit uk-fs--14 uk-tc--6b7280 uk-fw--500 uk-mg--b-4">Revenue</div>
          <div class="utilikit uk-fs--32 uk-fw--700 uk-tc--1f2937">$45.2K</div>
          <div class="utilikit uk-fs--12 uk-tc--10b981">+23% from last month</div>
        </div>
        <div class="utilikit uk-bg--ffffff uk-pd--20 uk-br--8 uk-bw--1 uk-bs--solid uk-bc--e5e7eb">
          <div class="utilikit uk-fs--14 uk-tc--6b7280 uk-fw--500 uk-mg--b-4">Orders</div>
          <div class="utilikit uk-fs--32 uk-fw--700 uk-tc--1f2937">89</div>
          <div class="utilikit uk-fs--12 uk-tc--ef4444">-5% from last month</div>
        </div>
        <div class="utilikit uk-bg--ffffff uk-pd--20 uk-br--8 uk-bw--1 uk-bs--solid uk-bc--e5e7eb">
          <div class="utilikit uk-fs--14 uk-tc--6b7280 uk-fw--500 uk-mg--b-4">Conversion</div>
          <div class="utilikit uk-fs--32 uk-fw--700 uk-tc--1f2937">2.4%</div>
          <div class="utilikit uk-fs--12 uk-tc--6b7280">No change</div>
        </div>
      </div>

      <!-- Content Area -->
      <div class="utilikit uk-dp--grid uk-gc--1fr uk-lg-gc--2fr-1fr uk-gp--24">
        <!-- Main Panel -->
        <div class="utilikit uk-bg--ffffff uk-pd--24 uk-br--8 uk-bw--1 uk-bs--solid uk-bc--e5e7eb">
          <h2 class="utilikit uk-fs--20 uk-fw--600 uk-mg--b-16">Recent Activity</h2>
          <div class="utilikit uk-dp--flex uk-fd--column uk-gp--12">
            <div class="utilikit uk-dp--flex uk-gp--12 uk-ai--center uk-pd--12 uk-bg--f9fafb uk-br--6">
              <div class="utilikit uk-wd--8 uk-ht--8 uk-bg--10b981 uk-br--50pr"></div>
              <span class="utilikit uk-fg--1 uk-fs--14">New user registration</span>
              <span class="utilikit uk-fs--12 uk-tc--6b7280">5 min ago</span>
            </div>
            <div class="utilikit uk-dp--flex uk-gp--12 uk-ai--center uk-pd--12 uk-bg--f9fafb uk-br--6">
