        <div class="utilikit uk-pd--12 uk-tc--e5e7eb uk-br--6">Analytics</div>
        <div class="utilikit uk-pd--12 uk-tc--e5e7eb uk-br--6">Users</div>
        <div class="utilikit uk-pd--12 uk-tc--e5e7eb uk-br--6">Settings</div>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="utilikit uk-fg--1 uk-pd--20 uk-lg-pd--32">
