<!-- SECTION 1: ADMIN DASHBOARD                                         -->
<!-- Full responsive dashboard with sidebar, stats, activity feed       -->
<!-- Demonstrates: grid, flexbox, responsive display, colors, spacing   -->
<!-- ================================================================== -->
<div class="utilikit uk-pd--32-20 uk-sm-pd--40-24 uk-bg--f8fafc">
  <div class="utilikit uk-xw--900 uk-mg--auto uk-mg--b-24">
    <p class="utilikit uk-fs--14 uk-fw--600 uk-tc--3b82f6 uk-ls--0d05em uk-mg--b-8">DASHBOARD</p>
    <h2 class="utilikit uk-fs--24 uk-sm-fs--28 uk-md-fs--32 uk-fw--700 uk-tc--1f2937 uk-mg--b-8">Admin Dashboard</h2>
    <p class="utilikit uk-fs--15 uk-tc--64748b uk-lh--1d6">Complete admin interface with sidebar navigation, stat cards, activity feed, and quick actions. Sidebar hides on mobile, stats reflow from 1 to 4 columns.</p>
  </div>
</div>

<div class="utilikit uk-bg--f8fafc uk-lh--1d6">
