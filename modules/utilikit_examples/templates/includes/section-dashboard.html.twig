    <div class="utilikit uk-dp--flex uk-gp--16 uk-ai--center">
      <span class="utilikit uk-fs--14 uk-tc--6b7280">Welcome, Admin</span>
      <div class="utilikit uk-wd--40 uk-ht--40 uk-bg--3b82f6 uk-br--50pr"></div>
    </div>
  </header>

  <!-- Main Container -->
  <div class="utilikit uk-dp--flex uk-ht--100pr">
    <!-- Sidebar - Hidden on mobile, visible on desktop -->
    <aside class="utilikit uk-dp--none uk-lg-dp--block uk-wd--250 uk-bg--1f2937 uk-pd--20">
      <nav class="utilikit uk-dp--flex uk-fd--column uk-gp--8">
