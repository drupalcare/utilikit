{
    "name": "drupal/utilikit",
    "description": "A comprehensive utility-first CSS framework for Drupal providing dynamic CSS generation, responsive design utilities, and performance-optimized rendering modes.",
    "type": "drupal-module",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "authors": [
        {
            "name": "Alaa Haddad (alaahaddad.com)",
            "homepage": "https://www.drupal.org/u/flashwebcenter",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://drupal.org/project/utilikit",
    "require": {
        "php": ">=8.1",
        "drupal/core": "^11.2 || ^12"
    },
    "support": {
        "issues": "https://drupal.org/project/issues/utilikit",
        "source": "https://git.drupalcode.org/project/utilikit"
    },
    "autoload": {
        "psr-4": {
            "Drupal\\utilikit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drupal\\Tests\\utilikit\\": "tests/src/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "suggest": {
        "drupal/ai": "^1.2 — required by the utilikit_ai sub-module, which is optional. utilikit itself does not need it."
    },
    "require-dev": {
        "drupal/coder": "^8.3",
        "mglaman/phpstan-drupal": "^2.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "scripts": {
        "phpcs": "phpcs --standard=phpcs.xml.dist",
        "phpcbf": "phpcbf --standard=phpcs.xml.dist",
        "phpstan": "phpstan analyse -c phpstan.neon --memory-limit=512M",
        "lint": [
            "@phpcs",
            "@phpstan"
        ]
    }
}
