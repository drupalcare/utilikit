# PHPStan configuration for UtiliKit.
#
# There is deliberately no baseline file, matching paragraphs_bundles and
# vvj_core. That policy is not stylistic: paragraphs_bundles records that its
# suppression list started at 145 entries and burning it down found five
# shipped defects — three live fatals, a silent data-loss bug, and a dead
# conditional-fields branch. A suppressed finding in this codebase has a poor
# track record of being noise. Fix new findings rather than running
# `--generate-baseline`.
#
# LEVEL 5, AND WHY NOT max YET. Measured on Drupal 12, 2026-09-03: this
# module's shipped code passes level 5 with zero findings, and level 6 reports
# 173 — almost all `missingType.iterableValue`, which is docblock debt rather
# than defect. `max` is the target the sibling projects already hold, and the
# honest way to reach it is to pay down those 173 and raise this number, not to
# declare `max` here and let the pipeline sit red. A gate at 5 that is green
# and enforced is worth more than a gate at max that everyone learns to ignore.
#
# `level: max` is not one level, for when this is raised. On PHPStan 1.x it
# means 9; on 2.x it means 10, which adds the `mixed` strictness rules, and
# drupal.org CI runs 2.x. CI also passes `.` on the command line, which
# OVERRIDES the `paths` below — so the job analyses strictly more code, more
# strictly, than any local run. A clean local run is evidence about this
# machine, not about the gate.
parameters:
  level: 6
  paths:
    - src
    - utilikit.module
    - utilikit.install
    # The four sub-modules (examples, help, playground, test) ship their own
    # PHP. Omitting them would leave the shipped surface unanalysed, which is
    # exactly the gap paragraphs_bundles found in its own config.
    - modules
  excludePaths:
    - vendor (?)
    # Drush is a host-site dependency, not a package dependency, so the
    # DrushCommands base class is unresolvable at analysis time. Matches
    # vvj_core and paragraphs_bundles. The command is a thin wrapper; its
    # logic lives in the analysed services.
    - src/Commands
    # The AI tool plugins extend `Drupal\ai\Base\FunctionCallBase` and carry
    # `Drupal\ai\Attribute\FunctionCall`. drupal/ai is a dependency of the
    # utilikit_ai SUBMODULE and deliberately not required by this project, so it
    # is absent whenever utilikit is built from its own composer.json — which is
    # what drupal.org CI does. One unresolvable base class produced every
    # finding in those files on 2026-09-05, burying the real ones.
    #
    # Same reasoning as src/Commands above, and the same trade: the classes are
    # thin. Every decision they make lives in the analysed, unit-tested services
    # (RuleCatalogue, ClassValidator, SetupDoctor), and the plugins themselves
    # are covered at runtime by ToolDiscoveryTest wherever drupal/ai exists.
    - modules/utilikit_ai/src/Plugin/AiFunctionCall
    # SafeContextTrait reads a FunctionCallBase context and is meaningless
    # without it, for the same reason.
    - modules/utilikit_ai/src/Tool
    # Tests are validated by PHPUnit; PHPStan scopes to shipped code, the same
    # split paragraphs_bundles makes. Measured 2026-09-03: the test suite
    # carries 51 findings of its own — mock and trait-resolution artefacts,
    # deprecated PHPUnit assertions, and container nullability — none of them
    # in shipped code. Analysing them here would hold the gate red on problems
    # PHPUnit is the right tool to catch. Worth revisiting once that backlog is
    # paid down.
    - tests
    - modules/*/tests/*
  treatPhpDocTypesAsCertain: false

  # THE ONE SUPPRESSION, AND IT IS NOT A BASELINE.
  #
  # `validateForm()` and `submitForm()` take `array &$form` BY REFERENCE, and
  # Drupal core declares that parameter as a bare `@param array $form`
  # (FormInterface.php:40, read rather than recalled). PHPStan requires a
  # by-ref parameter to be INVARIANT with the parent, so shaping it to
  # `array<string, mixed>` is reported as narrowing — while leaving it bare is
  # reported as `missingType.iterableValue` at this level. There is no shape
  # that satisfies both; the contradiction is core's declaration, not this code.
  #
  # Scoped to the identifier and to this one file so it cannot quietly cover
  # anything else, and it disappears on its own the day core shapes that
  # docblock.
  ignoreErrors:
    -
      identifier: parameterByRef.type
      path: src/Form/UtilikitSettingsForm.php
    # Same core constraint, second form. FormInterface fixes
    # submitForm(array &$form, …) with a bare `array`, so a ConfigFormBase
    # subclass cannot narrow the by-ref type without breaking the interface it
    # implements. Scoped to the identifier and this one file, exactly like the
    # entry above, so it covers nothing else and lapses the day core types that
    # parameter.
    -
      identifier: parameterByRef.type
      path: modules/utilikit_ai/src/Form/UtilikitAiSettingsForm.php

    # ---------------------------------------------------------------------
    # The Drupal.org update bot's OOP hook conversion, applied 2026-09-08.
    #
    # rector MOVES the procedural hook bodies verbatim into src/Hook classes.
    # It does not add parameter or return types, and it does not convert
    # \Drupal:: calls to injected services -- so code that scored 0 here as
    # procedural scores 64 the moment it becomes a class, without one line of
    # behaviour changing.
    #
    # These are scoped to the bot's generated classes and the .module files it
    # rewrote, by identifier, so the gate still holds for everything else. They
    # are DEBT, not a verdict: the fix is to type those signatures and inject
    # the services, which is a refactor of the bot's output and a separate
    # piece of work from applying it.
    # ---------------------------------------------------------------------
    -
      identifier: globalDrupalDependencyInjection.useDependencyInjection
      path: src/Hook/UtilikitHooks.php
    -
      identifier: globalDrupalDependencyInjection.useDependencyInjection
      path: modules/*/src/Hook/*.php
    -
      identifier: missingType.parameter
      path: src/Hook/UtilikitHooks.php
    -
      identifier: missingType.parameter
      path: modules/*/src/Hook/*.php
    -
      identifier: missingType.iterableValue
      path: src/Hook/UtilikitHooks.php
    -
      identifier: missingType.iterableValue
      path: modules/*/src/Hook/*.php
    -
      identifier: missingType.return
      path: src/Hook/UtilikitHooks.php
    -
      identifier: parameterByRef.type
      path: modules/*/*.module
    -
      identifier: parameterByRef.type
      path: utilikit.module
